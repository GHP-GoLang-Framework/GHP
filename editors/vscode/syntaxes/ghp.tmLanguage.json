{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "GHP",
  "scopeName": "source.ghp",
  "comment": "Gramática do GHP: HTML com tags <go ...> que embutem Go real. A ordem dos padrões em #ghp-tags importa — ver comentário lá.",
  "patterns": [
    { "include": "#ghp-tags" },
    { "include": "text.html.basic" }
  ],
  "repository": {
    "ghp-tags": {
      "comment": "Ordem obrigatória: as tags mais específicas primeiro. `go:import` antes de `go:*` genérico (senão `import` cairia no padrão de controle), e ambos antes de `go=`/`go` puro.",
      "patterns": [
        { "include": "#tag-import" },
        { "include": "#tag-block-close" },
        { "include": "#tag-control" },
        { "include": "#tag-echo" },
        { "include": "#tag-statement" }
      ]
    },

    "tag-import": {
      "comment": "<go:import (\"fmt\")> — um ou mais imports Go.",
      "name": "meta.tag.import.ghp",
      "begin": "(<)(go:import)(?![\\w:-])",
      "beginCaptures": {
        "1": { "name": "punctuation.definition.tag.begin.ghp" },
        "2": { "name": "keyword.control.import.ghp" }
      },
      "end": "(>)",
      "endCaptures": {
        "1": { "name": "punctuation.definition.tag.end.ghp" }
      },
      "contentName": "meta.embedded.block.go",
      "patterns": [{ "include": "source.go" }]
    },

    "tag-block-close": {
      "comment": "</go:if>, </go:switch>, </go:for> — fechamento dos blocos com corpo.",
      "name": "meta.tag.close.ghp",
      "match": "(</)(go:(?:if|switch|for))\\s*(>)",
      "captures": {
        "1": { "name": "punctuation.definition.tag.begin.ghp" },
        "2": { "name": "keyword.control.ghp" },
        "3": { "name": "punctuation.definition.tag.end.ghp" }
      }
    },

    "tag-control": {
      "comment": "Estruturas de controle. `else` e `default` não levam expressão; `if`, `switch`, `case` e `for` levam Go real até o `>`.",
      "name": "meta.tag.control.ghp",
      "begin": "(<)(go:(?:if|else|switch|case|default|for))(?![\\w:-])",
      "beginCaptures": {
        "1": { "name": "punctuation.definition.tag.begin.ghp" },
        "2": { "name": "keyword.control.ghp" }
      },
      "end": "(>)",
      "endCaptures": {
        "1": { "name": "punctuation.definition.tag.end.ghp" }
      },
      "contentName": "meta.embedded.block.go",
      "patterns": [{ "include": "source.go" }]
    },

    "tag-echo": {
      "comment": "<go= expressao> — renderiza o valor da expressão, com escaping automático.",
      "name": "meta.tag.echo.ghp",
      "begin": "(<)(go=)",
      "beginCaptures": {
        "1": { "name": "punctuation.definition.tag.begin.ghp" },
        "2": { "name": "keyword.control.echo.ghp" }
      },
      "end": "(>)",
      "endCaptures": {
        "1": { "name": "punctuation.definition.tag.end.ghp" }
      },
      "contentName": "meta.embedded.block.go",
      "patterns": [{ "include": "source.go" }]
    },

    "tag-statement": {
      "comment": "<go ...> — bloco de código Go (statement), possivelmente multi-linha. O lookahead impede casar com `go:`, `go=` ou identificadores que só começam com `go` (ex.: um literal `<google>` em HTML).",
      "name": "meta.tag.statement.ghp",
      "begin": "(<)(go)(?![\\w:=-])",
      "beginCaptures": {
        "1": { "name": "punctuation.definition.tag.begin.ghp" },
        "2": { "name": "keyword.control.ghp" }
      },
      "end": "(>)",
      "endCaptures": {
        "1": { "name": "punctuation.definition.tag.end.ghp" }
      },
      "contentName": "meta.embedded.block.go",
      "patterns": [{ "include": "source.go" }]
    }
  }
}
