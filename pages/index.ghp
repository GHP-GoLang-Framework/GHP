<@go
    if r.Method == "POST" {
        if r.URL.Query().Get("action") == "reset" {
            ghp.SetState("count", 0)
        } else {
            ghp.SetState("count", ghp.GetState("count", 0)+1)
        }
    }
    count := ghp.GetState("count", 0)
@>
<@go if r.Method == "POST" { @>
  <p>Contador: <strong><@= count @></strong></p>
  <p class="stars"><@go for i := 0; i < count; i++ { @>★<@go } @></p>
<@go
        return
    }
@>
<!doctype html>
<html lang="pt-br">
<head>
  <meta charset="utf-8">
  <title>GHP demo</title>
  <style>
    body { font-family: system-ui, sans-serif; max-width: 40rem; margin: 4rem auto; padding: 0 1rem; color: #111; }
    .stars { font-size: 1.5rem; letter-spacing: 0.2rem; min-height: 2rem; }
    .btn { display: inline-block; padding: .5rem 1rem; margin-right: .5rem; background: #111; color: #fff; text-decoration: none; border-radius: .4rem; font-weight: 600; border: 0; cursor: pointer; font-size: 1rem; }
    .btn.secondary { background: #888; }
    code { background: #f0f0f0; padding: .1rem .3rem; border-radius: .2rem; }
  </style>
</head>
<body>
  <h1>GHP — Good Hygiene Practices</h1>
  <p>
    Esta página é <code>pages/index.ghp</code>: HTML puro misturado com Go de
    verdade. O contador abaixo vive em memória no processo Go
    (<code>ghp.GetState</code> / <code>ghp.SetState</code>), não na URL — o
    clique dispara um <code>fetch()</code> que chama o mesmo handler via
    <code>POST</code> e troca só o <code>&lt;div id="counter"&gt;</code>, sem
    recarregar a página.
  </p>

  <div id="counter">
    <p>Contador: <strong><@= count @></strong></p>
    <p class="stars"><@go for i := 0; i < count; i++ { @>★<@go } @></p>
  </div>

  <p>
    <button class="btn" id="incr">+1</button>
    <button class="btn secondary" id="reset">reset</button>
  </p>

  <script>
    async function bump(action) {
      const url = new URL(location.pathname, location.origin);
      if (action) url.searchParams.set("action", action);
      const res = await fetch(url, { method: "POST" });
      document.getElementById("counter").innerHTML = await res.text();
    }
    document.getElementById("incr").addEventListener("click", () => bump());
    document.getElementById("reset").addEventListener("click", () => bump("reset"));
  </script>
</body>
</html>
