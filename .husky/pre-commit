# Formata apenas os arquivos .go staged e os re-adiciona ao index, depois
# roda vet no repositório inteiro (equivalente ao gofmt+tsc do fluxo do Nexo).
staged_go_files=$(git diff --cached --name-only --diff-filter=ACM -- '*.go')

if [ -n "$staged_go_files" ]; then
  gofmt -w $staged_go_files
  git add $staged_go_files
fi

go vet ./...
